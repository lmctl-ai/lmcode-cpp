# Precompiled vectors bind to the exact schema bytes, including line endings.
conformance/vectors/*.json text eol=lf
*.dslb binary
conformance/stdlib-vectors/*.json text eol=lf
conformance/stdlib-vectors/*.dsl text eol=lf
conformance/stdlib-vectors/*.expect text eol=lf
conformance/return-vectors/*.dsl text eol=lf
conformance/return-vectors/*.expect text eol=lf
conformance/return-vectors/*.json text eol=lf

# Canonical standard surface is hashed byte-for-byte by every SDK.
std/*.json text eol=lf

# Portable sample corpus and exact stdout are byte-for-byte fixtures.
sample-suite/** text eol=lf
sample-suite/bytecode/*.dslb binary

# Terminal protocol frames and schema/source digests are literal LF bytes.
conformance/return-vectors/** text eol=lf
conformance/return-vectors/*.dslb binary
