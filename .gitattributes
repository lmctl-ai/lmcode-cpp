# Precompiled vectors bind to the exact schema bytes, including line endings.
conformance/vectors/*.json text eol=lf
*.dslb binary
conformance/stdlib-vectors/*.json text eol=lf
conformance/stdlib-vectors/*.dsl text eol=lf
conformance/stdlib-vectors/*.expect text eol=lf

# Canonical standard surface is hashed byte-for-byte by every SDK.
std/*.json text eol=lf
